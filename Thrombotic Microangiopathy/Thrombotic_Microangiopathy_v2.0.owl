    <!-- http://purl.obolibrary.org/obo/CHEBI_229652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_229652">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0016244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A member of the class of indoles that is a potent inhibitor of complement factor B with potential immunomodulatory activity. It is a twice-daily oral complement alternative pathway inhibitor that blocks factor B, preventing C3 convertase assembly and downstream C5 activation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:1644670-37-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugbank:DB16200</oboInOwl:hasDbXref>
