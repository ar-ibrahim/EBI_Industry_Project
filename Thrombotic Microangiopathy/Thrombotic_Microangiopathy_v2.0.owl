    <!-- http://purl.obolibrary.org/obo/NCIT_C169784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C169784">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C29726"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A recombinant human form of a disintegrin and metalloproteinase with thrombospondin motifs 13 (ADAMTS13) that may be used as a replacement therapy for ADAMTS13 with indirect anti-thrombotic and anti-thrombocytopenic activities. Upon administration, apadamtase alfa acts similarly as endogenous ADAMTS13 and mediates the cleavage of von Willebrand factor (VWF) at the Tyr1605-Met1606 bond in the A2 domain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">Adzynma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Apadamtase Alfa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Recombinant ADAMTS13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TAK-755</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">rADAMTS13</oboInOwl:hasExactSynonym>
        <oboInOwl:id>NCIT:C169784</oboInOwl:id>
        <rdfs:label xml:lang="en">Apadamtase Alfa</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C1702 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C1702">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C129822"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C141215"/>
