        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000211"/>
        <obo:IAO_0000115 xml:lang="en">A cell whose function is determined by its response to an electric signal.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000393</oboInOwl:id>
        <rdfs:label xml:lang="en">electrically responsive cell</rdfs:label>
    </owl:Class>
    


