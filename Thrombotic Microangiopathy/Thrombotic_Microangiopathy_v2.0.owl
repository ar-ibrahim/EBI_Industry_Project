    <!-- http://purl.obolibrary.org/obo/CHEBI_35341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51958"/>
        <obo:IAO_0000115 xml:lang="en">Any of naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at C-10 and C-13, and often an alkyl group at C-17. By extension, one or more bond scissions, ring expansions and/or ring contractions of the skeleton may have occurred. Natural steroids are derived biogenetically from squalene which is a triterpene.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>kegg.compound:C00377</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">steroids</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHEBI:35341</oboInOwl:id>
        <rdfs:label xml:lang="en">steroid</rdfs:label>
    </owl:Class>
    


