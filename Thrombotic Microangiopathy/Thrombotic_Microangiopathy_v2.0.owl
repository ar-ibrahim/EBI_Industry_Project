        <hasNCTId>NCT03922308</hasNCTId>
        <hasTrialPhase>Phase II</hasTrialPhase>
        <hasTrialStatus>Completed</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">Phase 2 double-blind, placebo-controlled RCT evaluating recombinant ADAMTS13 (apadamtase alfa / SHP655) added to standard of care in acquired TTP. Explores enzyme replacement as an alternative to plasma exchange for restoring ADAMTS13 activity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT03922308 (recombinant ADAMTS13 in acquired TTP; Phase II, Completed)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT04889430 -->

    <owl:Class rdf:about="http://example.org/tma#NCT04889430">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#investigatesTherapy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_229652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0016244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasNCTId>NCT04889430</hasNCTId>
        <hasTrialPhase>Phase III</hasTrialPhase>
        <hasTrialStatus>Active, not recruiting</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">Phase 3 single-arm open-label trial of iptacopan (oral factor B inhibitor) in complement inhibitor-naive adult aHUS patients. Iptacopan blocks the alternative pathway proximal to C5, offering a twice-daily oral alternative to intravenous anti-C5 monoclonal antibodies.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT04889430 (iptacopan in aHUS; Phase III, Active, not recruiting)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT06389474 -->

    <owl:Class rdf:about="http://example.org/tma#NCT06389474">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#investigatesTherapy"/>
                <owl:someValuesFrom rdf:resource="http://example.org/tma#INM004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019536"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasNCTId>NCT06389474</hasNCTId>
        <hasTrialPhase>Phase III</hasTrialPhase>
        <hasTrialStatus>Recruiting</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">Phase 3 RCT of INM004 (polyclonal anti-Shiga toxin antibody preparation) in pediatric STEC-HUS. INM004 neutralizes circulating Shiga toxin 1 and 2 to prevent endothelial injury, addressing an unmet need as no disease-modifying therapy currently exists for STEC-HUS.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT06389474 (INM004 in pediatric STEC-HUS; Phase III, Recruiting)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT06831058 -->

    <owl:Class rdf:about="http://example.org/tma#NCT06831058">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#investigatesTherapy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C171817"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasNCTId>NCT06831058</hasNCTId>
        <hasTrialPhase>Phase II</hasTrialPhase>
        <hasTrialStatus>Recruiting</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">Pilot study of efgartigimod alfa (neonatal Fc receptor inhibitor) in immune-mediated TTP. Efgartigimod depletes pathogenic IgG anti-ADAMTS13 autoantibodies by blocking FcRn-mediated IgG recycling, offering a novel immunomodulatory approach distinct from rituximab.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT06831058 (efgartigimod alfa in immune-mediated TTP; Phase II, Recruiting)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#OrganIschemiaAndEndOrganDamage -->

    <owl:Class rdf:about="http://example.org/tma#OrganIschemiaAndEndOrganDamage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000540"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0002188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Microvascular thrombosis causes ischemia in multiple organ systems. In TTP, neurological involvement predominates (confusion, seizures, stroke). In HUS, renal involvement predominates with acute kidney injury, often requiring dialysis. Myocardial, gastrointestinal, and hepatic involvement can also occur, contributing to the high morbidity of TMA syndromes.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Organ Ischemia and End-Organ Damage</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#PlateletAggregationAndMicrovascularThrombosis -->

    <owl:Class rdf:about="http://example.org/tma#PlateletAggregationAndMicrovascularThrombosis">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115 xml:lang="en">Activated platelets adhere to damaged endothelium and ultra-large VWF multimers, forming platelet-rich microthrombi in arterioles and capillaries. These thrombi cause mechanical destruction of erythrocytes passing through narrowed vessels (producing schistocytes), consumptive thrombocytopenia, and downstream ischemia to vital organs including the brain and kidneys.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Platelet Aggregation and Microvascular Thrombosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0070527"/>
    </owl:Class>
    


    <!-- http://example.org/tma#SecondaryThromboticMicroangiopathy -->

    <owl:Class rdf:about="http://example.org/tma#SecondaryThromboticMicroangiopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
        <obo:IAO_0000115 xml:lang="en">A thrombotic microangiopathy that arises in the context of another systemic condition rather than a primary abnormality of complement regulation or of ADAMTS13 activity. Recognised contexts include pregnancy and HELLP syndrome, autoimmune disease (particularly systemic lupus erythematosus and scleroderma renal crisis), malignancy, severe or malignant hypertension, haematopoietic stem cell and solid organ transplantation, and infection other than Shiga toxin-producing Escherichia coli. The category is defined by the presence of an underlying condition rather than by a shared mechanism, so it is a clinical grouping rather than a mechanistic one. No MONDO term exists for this grouping, so it is represented as a local class of this application ontology. Per KDIGO 2024 the primary/secondary terminology is under active revision and this grouping should be treated as provisional.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">secondary TMA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">secondary thrombotic microangiopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">TMA associated with a coexisting condition</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Secondary Thrombotic Microangiopathy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/tma#SecondaryThromboticMicroangiopathy"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A thrombotic microangiopathy that arises in the context of another systemic condition rather than a primary abnormality of complement regulation or of ADAMTS13 activity. Recognised contexts include pregnancy and HELLP syndrome, autoimmune disease (particularly systemic lupus erythematosus and scleroderma renal crisis), malignancy, severe or malignant hypertension, haematopoietic stem cell and solid organ transplantation, and infection other than Shiga toxin-producing Escherichia coli. The category is defined by the presence of an underlying condition rather than by a shared mechanism, so it is a clinical grouping rather than a mechanistic one. No MONDO term exists for this grouping, so it is represented as a local class of this application ontology. Per KDIGO 2024 the primary/secondary terminology is under active revision and this grouping should be treated as provisional.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:40372375</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://example.org/tma#ShigaToxinMediatedEndothelialInjury -->

    <owl:Class rdf:about="http://example.org/tma#ShigaToxinMediatedEndothelialInjury">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0002188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">In STEC-HUS, Shiga toxin (Stx1, Stx2) produced by enterohemorrhagic E. coli binds to globotriaosylceramide (Gb3) receptors expressed on renal tubular and glomerular endothelial cells. Internalized toxin inhibits protein synthesis, triggering endothelial apoptosis and activating inflammatory pathways. Stx also induces upregulation of Gb3 expression and promotes thrombotic microangiopathy predominantly in the kidney.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Shiga Toxin-Mediated Endothelial Injury</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#TherapeuticAgent -->

    <owl:Class rdf:about="http://example.org/tma#TherapeuticAgent">
        <obo:IAO_0000115 xml:lang="en">A therapeutic agent used or investigated in the treatment of thrombotic microangiopathy or its subtypes.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Therapeutic Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#VWFMultimerCleavage -->

    <owl:Class rdf:about="http://example.org/tma#VWFMultimerCleavage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115 xml:lang="en">The proteolytic processing of ultra-large von Willebrand factor multimers secreted by endothelial cells into smaller, less adhesive multimers. Disruption of this process leaves ultra-large multimers in circulation, where they recruit platelets under high shear stress.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">VWF Multimer Cleavage</rdfs:label>
    </owl:Class>
    


