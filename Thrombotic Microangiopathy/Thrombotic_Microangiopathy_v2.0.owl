    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0002252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002376"/>
        <obo:IAO_0000115 xml:lang="en">Any process of the immune system that executes a component of an immune response. An effector immune process takes place after its activation.</obo:IAO_0000115>
        <oboInOwl:id>GO:0002252</oboInOwl:id>
        <rdfs:label xml:lang="en">immune effector process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0002253 -->

