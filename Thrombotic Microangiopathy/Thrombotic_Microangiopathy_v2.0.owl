        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A natural or synthetic analogue of the hormones secreted by the adrenal gland.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym xml:lang="en">corticoides</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">corticosteroids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:50858</oboInOwl:id>
        <rdfs:label xml:lang="en">corticosteroid</rdfs:label>
    </owl:Class>
    


