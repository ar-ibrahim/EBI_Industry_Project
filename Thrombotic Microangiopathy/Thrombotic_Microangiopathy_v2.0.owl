        <oboInOwl:hasDbXref>MESH:D001773</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0000081</oboInOwl:id>
        <rdfs:label xml:lang="en">blood cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
        <obo:IAO_0000115 xml:lang="en">An endothelial cell comprises the outermost layer or lining of anatomical structures and can be squamous or cuboidal. In mammals, endothelial cell has vimentin filaments and is derived from the mesoderm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001176</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:66772</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">endotheliocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000115</oboInOwl:id>
        <rdfs:label xml:lang="en">endothelial cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000151">
