<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/tma#"
     xml:base="http://example.org/tma"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tma="http://example.org/tma#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://example.org/tma">
        <owl:versionIRI rdf:resource="http://example.org/tma/2.0"/>
        <terms:creator>EMBL-EBI Industry Programme — disease ontology harmonisation project</terms:creator>
        <terms:date>2026-08-28</terms:date>
        <terms:description>OWL representation of Thrombotic Microangiopathy (TMA) pathophysiology from the dismech knowledge base, integrating OBO Foundry ontology terms (MONDO, HP, CL, GO, UBERON, SO, CHEBI, NCIT) and HGNC gene identifiers with RO semantic relations.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>Thrombotic Microangiopathy Application Ontology</terms:title>
        <rdfs:comment xml:lang="en">NAMESPACE: This file uses the placeholder base IRI http://example.org/tma. No PURL has been registered for this ontology; it is maintained as an internal application ontology of the EMBL-EBI Industry Programme.

PROVENANCE: imported terms are MIREOT-style stubs extracted via the EMBL-EBI Ontology Lookup Service (OLS4, https://www.ebi.ac.uk/ols4) on 2026-08-28, from the then-current releases of MONDO, HP, CL, GO, UBERON, SO, CHEBI and NCIT. Causative genes are identified by HGNC IRIs of the form http://identifiers.org/hgnc/&lt;id&gt;, following MONDO&apos;s own disease_series_by_gene design pattern; each was verified against the HGNC REST API. These replaced OGG classes in v2.0, because OGG no longer resolves at any PURL and is not loaded in OLS4, which left the gene terms unresolvable for users. The causative-gene list is provisional: a ClinGen curation project for these genes is ongoing (https://www.clinicalgenome.org/affiliation/40069/).</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    


