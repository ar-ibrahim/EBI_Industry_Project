            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A recombinant chimeric murine/human antibody directed against the CD20 antigen, a hydrophobic transmembrane protein located on normal pre-B and mature B lymphocytes. Following binding, rituximab triggers a host cytotoxic immune response against CD20-positive cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">MabThera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Rituxan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">rituximab</oboInOwl:hasExactSynonym>
        <oboInOwl:id>NCIT:C1702</oboInOwl:id>
        <rdfs:label xml:lang="en">Rituximab</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C171817 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C171817">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C574"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A human immunoglobulin G1 (IgG1)-derived Fc fragment that targets the neonatal Fc receptor (FcRn), with potential FcRn blocking activity. Upon administration, efgartigimod alfa targets, binds to and blocks FcRn, thereby preventing FcRn from recycling IgG back into the systemic circulation, causing a reduction in IgG blood levels including pathogenic autoantibodies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">ARGX-113</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Efgartigimod Alfa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vyvgart</oboInOwl:hasExactSynonym>
        <oboInOwl:id>NCIT:C171817</oboInOwl:id>
        <rdfs:label xml:lang="en">Efgartigimod Alfa</rdfs:label>
    </owl:Class>
    


