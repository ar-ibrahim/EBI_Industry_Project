        <oboInOwl:hasExactSynonym xml:lang="en">TTP</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MONDO:0018896</oboInOwl:id>
        <rdfs:label xml:lang="en">thrombotic thrombocytopenic purpura</rdfs:label>
