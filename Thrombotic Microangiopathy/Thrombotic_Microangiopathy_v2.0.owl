        <oboInOwl:hasExactSynonym xml:lang="en">erythropoietic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000764</oboInOwl:id>
        <rdfs:label xml:lang="en">erythroid lineage cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A cell of a hematopoietic lineage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:70366</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">haematopoietic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hemopoietic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000988</oboInOwl:id>
        <rdfs:label xml:lang="en">hematopoietic cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000666"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002681"/>
        <obo:IAO_0000115 xml:lang="en">An endothelial cell that is part of the glomerulus of the kidney. This cell is flattened, highly fenestrated, and plays a vital role in the formation of glomerular ultrafiltrate.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0004632</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:70970</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002188</oboInOwl:id>
        <rdfs:label xml:lang="en">glomerular endothelial cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
        <obo:IAO_0000115 xml:lang="en">A cell that is part of the nervous system.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:70333</oboInOwl:hasDbXref>
        <oboInOwl:id>CL:0002319</oboInOwl:id>
        <rdfs:label xml:lang="en">neural cell</rdfs:label>
    </owl:Class>
    


