    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000211"/>
        <obo:IAO_0000115 xml:lang="en">A cell that initiates an electrical signal and passes that signal to another cell.</obo:IAO_0000115>
        <oboInOwl:id>CL:0000404</oboInOwl:id>
        <rdfs:label xml:lang="en">electrically signaling cell</rdfs:label>
    </owl:Class>
    


