    <!-- http://example.org/tma#ADAMTS13DeficiencyAndUltraLargeVWFMultimers -->

    <owl:Class rdf:about="http://example.org/tma#ADAMTS13DeficiencyAndUltraLargeVWFMultimers">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000115"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">In TTP, severe deficiency of ADAMTS13 (a disintegrin and metalloproteinase with a thrombospondin type 1 motif, member 13) prevents cleavage of ultra-large von Willebrand factor multimers (UL-VWF) secreted by endothelial cells. UL-VWF strings recruit platelets under high shear stress, forming platelet-rich microthrombi predominantly in arterioles and capillaries. This leads to consumptive thrombocytopenia and mechanical red blood cell fragmentation (schistocyte formation).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ADAMTS13 Deficiency and Ultra-Large VWF Multimers</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://example.org/tma#ADAMTS13EnzymeActivity"/>
        <rdfs:seeAlso rdf:resource="http://example.org/tma#VWFMultimerCleavage"/>
    </owl:Class>
    


    <!-- http://example.org/tma#ADAMTS13EnzymeActivity -->

    <owl:Class rdf:about="http://example.org/tma#ADAMTS13EnzymeActivity">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0004222"/>
        <obo:IAO_0000115 xml:lang="en">The metalloprotease activity of ADAMTS13, which cleaves von Willebrand factor at the Tyr1605-Met1606 bond within the A2 domain. Severe deficiency of this activity (conventionally below 10% of normal) is the defining functional abnormality of thrombotic thrombocytopenic purpura.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">ADAMTS13 Enzyme Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#ClinicalTrial -->

    <owl:Class rdf:about="http://example.org/tma#ClinicalTrial">
        <obo:IAO_0000115 xml:lang="en">A clinical trial investigating a therapeutic intervention for a disease.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Clinical Trial</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#ComplementAlternativePathwayDysregulation -->

    <owl:Class rdf:about="http://example.org/tma#ComplementAlternativePathwayDysregulation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115 xml:lang="en">In atypical HUS, loss-of-function variants in complement regulatory proteins (CFH, CFI, MCP/CD46) or gain-of-function variants in complement activators (CFB, C3) lead to uncontrolled complement activation on endothelial cell surfaces. Unopposed C3 convertase activity generates C3b deposition and membrane attack complex (MAC) formation, causing direct endothelial lysis and activation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Complement Alternative Pathway Dysregulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0006957"/>
    </owl:Class>
    


    <!-- http://example.org/tma#DrugInducedThromboticMicroangiopathy -->

    <owl:Class rdf:about="http://example.org/tma#DrugInducedThromboticMicroangiopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
        <obo:IAO_0000115 xml:lang="en">A thrombotic microangiopathy that is temporally associated with exposure to a therapeutic agent, arising either through a drug-dependent antibody (immune) mechanism or through dose-dependent toxic injury to the microvascular endothelium. Implicated agents include quinine, gemcitabine, mitomycin C, calcineurin inhibitors such as ciclosporin and tacrolimus, VEGF inhibitors such as bevacizumab, interferon, and the thienopyridines ticlopidine and clopidogrel. Withdrawal of the implicated agent is the primary intervention, which is what makes this grouping clinically useful. No MONDO term exists for this grouping, so it is represented as a local class of this application ontology.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">DITMA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">drug-induced TMA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">drug-induced thrombotic microangiopathy</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">Drug-Induced Thrombotic Microangiopathy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://example.org/tma#DrugInducedThromboticMicroangiopathy"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A thrombotic microangiopathy that is temporally associated with exposure to a therapeutic agent, arising either through a drug-dependent antibody (immune) mechanism or through dose-dependent toxic injury to the microvascular endothelium. Implicated agents include quinine, gemcitabine, mitomycin C, calcineurin inhibitors such as ciclosporin and tacrolimus, VEGF inhibitors such as bevacizumab, interferon, and the thienopyridines ticlopidine and clopidogrel. Withdrawal of the implicated agent is the primary intervention, which is what makes this grouping clinically useful. No MONDO term exists for this grouping, so it is represented as a local class of this application ontology.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25414441</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://example.org/tma#EndothelialCellInjuryAndActivation -->

    <owl:Class rdf:about="http://example.org/tma#EndothelialCellInjuryAndActivation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115 xml:lang="en">The unifying initiating event in all TMA subtypes is injury to microvascular endothelial cells. Endothelial damage exposes subendothelial matrix, triggers von Willebrand factor (VWF) release, and activates the coagulation cascade. Endothelial activation leads to upregulation of adhesion molecules, procoagulant surface expression, and loss of anticoagulant thrombomodulin expression.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Endothelial Cell Injury and Activation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0042118"/>
    </owl:Class>
    


    <!-- http://example.org/tma#INM004 -->

    <owl:Class rdf:about="http://example.org/tma#INM004">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002606"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019536"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">INM004 is a polyclonal anti-Shiga toxin antibody preparation. It neutralizes circulating Shiga toxin 1 and 2 to prevent endothelial injury in STEC-HUS.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">INM004 (polyclonal anti-Shiga toxin antibody; investigational, no CHEBI/NCIT term)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#MicroangiopathicHemolyticAnemiaProcess -->

    <owl:Class rdf:about="http://example.org/tma#MicroangiopathicHemolyticAnemiaProcess">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000232"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Red blood cells passing through partially occluded microvessels are subjected to mechanical shear forces, leading to fragmentation and formation of schistocytes. This non-immune hemolytic anemia is characterized by elevated lactate dehydrogenase (LDH), low haptoglobin, elevated reticulocyte count, and negative direct antiglobulin test (Coombs test).</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Microangiopathic Hemolytic Anemia (Pathophysiological Process)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT02205541 -->

    <owl:Class rdf:about="http://example.org/tma#NCT02205541">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#investigatesTherapy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C48386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019536"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasNCTId>NCT02205541</hasNCTId>
        <hasTrialPhase>Phase III</hasTrialPhase>
        <hasTrialStatus>Completed</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">ECULISHU — first prospective randomized placebo-controlled trial of eculizumab in pediatric STEC-HUS. This landmark study found that complement inhibition does not benefit typical STEC-HUS, clarifying the pathophysiological distinction from aHUS and establishing that STEC-HUS management remains supportive.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT02205541 ECULISHU (eculizumab in pediatric STEC-HUS; Phase III, Completed)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT02553317 -->

    <owl:Class rdf:about="http://example.org/tma#NCT02553317">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#investigatesTherapy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCIT_C128625"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/tma#targetedDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019740"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasNCTId>NCT02553317</hasNCTId>
        <hasTrialPhase>Phase III</hasTrialPhase>
        <hasTrialStatus>Completed</hasTrialStatus>
        <obo:IAO_0000115 xml:lang="en">HERCULES trial — Phase III double-blind, placebo-controlled RCT evaluating caplacizumab in acquired TTP. Established caplacizumab as the first approved targeted therapy for TTP, demonstrating faster platelet recovery and reduced TTP-related death, recurrence, and thromboembolic events.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">NCT02553317 HERCULES (caplacizumab in acquired TTP; Phase III, Completed)</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/tma#NCT03922308 -->

    <owl:Class rdf:about="http://example.org/tma#NCT03922308">
        <rdfs:subClassOf rdf:resource="http://example.org/tma#ClinicalTrial"/>
