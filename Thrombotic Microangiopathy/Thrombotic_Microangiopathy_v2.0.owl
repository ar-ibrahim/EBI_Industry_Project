    <!-- http://example.org/tma#investigatesTherapy -->

    <owl:ObjectProperty rdf:about="http://example.org/tma#investigatesTherapy">
        <rdfs:domain rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://example.org/tma#TherapeuticAgent"/>
        <obo:IAO_0000115 xml:lang="en">Relates a clinical trial to a therapeutic agent it evaluates as an interventional arm. Comparators, placebo arms and standard-of-care backgrounds are not asserted with this property.</obo:IAO_0000115>
        <rdfs:label>investigates therapy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/tma#targetedDisease -->

    <owl:ObjectProperty rdf:about="http://example.org/tma#targetedDisease">
        <rdfs:domain rdf:resource="http://example.org/tma#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Relates a clinical trial to a disease it studies. Both the specific subtype enrolled and any broader disease grouping it falls under may be asserted; the enrolled population is given in the trial&apos;s own definition.</obo:IAO_0000115>
        <rdfs:label>targeted disease</rdfs:label>
    </owl:ObjectProperty>
    


