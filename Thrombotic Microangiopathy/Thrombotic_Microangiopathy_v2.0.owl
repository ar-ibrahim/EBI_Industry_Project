        <oboInOwl:hasExactSynonym xml:lang="en">non-nucleated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000225</oboInOwl:id>
        <rdfs:label xml:lang="en">anucleate cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000081"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000329"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000764"/>
        <obo:IAO_0000115 xml:lang="en">A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000424</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0290</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:81100</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">RBC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">red blood cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000232</oboInOwl:id>
        <rdfs:label xml:lang="en">erythrocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000081"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000225"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000458"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000763"/>
        <obo:IAO_0000115 xml:lang="en">A non-nucleated disk-shaped cell formed by extrusion from megakaryocytes, found in the blood of all mammals, and mainly involved in blood coagulation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000132</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0803</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62851</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">anucleate thrombocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">blood platelet</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">enucleate thrombocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:0000233</oboInOwl:id>
        <rdfs:label xml:lang="en">platelet</rdfs:label>
    </owl:Class>
    


