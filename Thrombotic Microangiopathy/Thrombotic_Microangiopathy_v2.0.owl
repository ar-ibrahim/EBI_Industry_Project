    <!-- http://example.org/tma#hasNCTId -->

    <owl:AnnotationProperty rdf:about="http://example.org/tma#hasNCTId">
        <rdfs:comment xml:lang="en">ClinicalTrials.gov registry identifier, matching the pattern NCT followed by eight digits.</rdfs:comment>
        <rdfs:label>has NCT identifier</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- http://example.org/tma#hasTrialPhase -->

    <owl:AnnotationProperty rdf:about="http://example.org/tma#hasTrialPhase">
        <rdfs:comment xml:lang="en">Controlled vocabulary; permitted values are exactly: &quot;Early Phase 1&quot;, &quot;Phase I&quot;, &quot;Phase I/II&quot;, &quot;Phase II&quot;, &quot;Phase II/III&quot;, &quot;Phase III&quot;, &quot;Phase IV&quot;, &quot;Not Applicable&quot;. Any other string is an error.</rdfs:comment>
        <rdfs:label>has trial phase</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- http://example.org/tma#hasTrialStatus -->

    <owl:AnnotationProperty rdf:about="http://example.org/tma#hasTrialStatus">
        <rdfs:comment xml:lang="en">Controlled vocabulary; permitted values are exactly the ClinicalTrials.gov overall-status strings: &quot;Not yet recruiting&quot;, &quot;Recruiting&quot;, &quot;Enrolling by invitation&quot;, &quot;Active, not recruiting&quot;, &quot;Suspended&quot;, &quot;Terminated&quot;, &quot;Completed&quot;, &quot;Withdrawn&quot;, &quot;Unknown status&quot;. Note the comma in &quot;Active, not recruiting&quot; — any other spelling is an error.</rdfs:comment>
        <rdfs:label>has trial status</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


